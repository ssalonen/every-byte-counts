# fastlane lanes for Every Byte Counts (iOS only).
#
# `beta` is the release lane (called by release.yml): sync signing, build a
# signed IPA, verify it carries every declared entitlement, and upload to
# TestFlight. `certificates` seeds/syncs signing (e.g. from a Mac).

default_platform(:ios)

APP_ID    = "fi.mailhub.everybytecounts"
WIDGET_ID = "fi.mailhub.everybytecounts.widget"
PROJECT   = "EveryByteCounts.xcodeproj"
SCHEME    = "EveryByteCounts"
APP_TARGET    = "EveryByteCounts"
WIDGET_TARGET = "EveryByteCountsWidgetExtension"

# Repo root. fastlane runs lanes with its CWD set to the fastlane/ dir, so a
# CWD-relative File.expand_path("App/…") resolves to fastlane/App/… — wrong.
# Anchor every repo-file reference here instead. On CI this is the checkout root
# (GITHUB_WORKSPACE); locally, the parent of this Fastfile's directory.
REPO_ROOT = ENV["GITHUB_WORKSPACE"] || File.expand_path("..", __dir__)

# Declared entitlements — the source of truth re-asserted after Xcode packaging.
APP_ENTITLEMENTS    = File.join(REPO_ROOT, "App/EveryByteCounts/EveryByteCounts.entitlements")
WIDGET_ENTITLEMENTS = File.join(REPO_ROOT, "Widget/EveryByteCountsWidget/EveryByteCountsWidget.entitlements")
ENTITLEMENTS_TOOL   = File.join(REPO_ROOT, "scripts/entitlements.py")

platform :ios do
  desc "Sync signing material (read-only on CI) without building anything"
  lane :certificates do
    # force: true so this also creates a dedicated, password-known keychain when
    # run locally (e.g. seeding from a Mac). Without it, match installs into the
    # login keychain and can't run `security set-key-partition-list`
    # non-interactively — the identity never forms and match reports "could not
    # find the newly generated certificate installed" (errSecInternalComponent).
    setup_ci(force: true)
    match(api_key: asc_api_key, type: "appstore", readonly: FastlaneCore::Helper.ci?)
  end

  desc "Build and upload a signed build to TestFlight"
  lane :beta do
    setup_ci
    key = asc_api_key
    ipa = build_signed_ipa(key)
    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      # Internal testers only — don't submit for external Beta App Review, and
      # don't block CI while App Store Connect processes the build.
      skip_submission: true,
      skip_waiting_for_build_processing: true,
    )
  end
end

# Sync signing, produce a signed App-Store IPA, verify it carries every declared
# entitlement, and return its absolute path (for upload_to_testflight).
# MARKETING_VERSION comes from release.yml (the tag); build number from the CI
# run number.
def build_signed_ipa(key)
  # readonly by default. Set MATCH_READONLY=false (needs a *write* deploy key and
  # an API key allowed to manage profiles) to regenerate profiles from CI after
  # changing App-ID capabilities, instead of re-seeding from a Mac.
  match(api_key: key, type: "appstore", readonly: ENV["MATCH_READONLY"] != "false")

  # Stamp manual signing + the match profiles into the freshly generated project,
  # so project.yml carries no signing settings (a source of the XcodeGen pain).
  apply_signing(APP_TARGET,    ENV.fetch("sigh_#{APP_ID}_appstore_profile-name"))
  apply_signing(WIDGET_TARGET, ENV.fetch("sigh_#{WIDGET_ID}_appstore_profile-name"))

  marketing_version = ENV["MARKETING_VERSION"] || "0.0.1"
  build_number = ENV["GITHUB_RUN_NUMBER"] || "1"
  archive_path = File.join(REPO_ROOT, "build/EveryByteCounts.xcarchive")

  # 1. Archive only — no IPA yet; we export and then re-sign the IPA ourselves.
  build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    clean: true,
    skip_package_ipa: true,
    archive_path: archive_path,
    xcargs: [
      "MARKETING_VERSION=#{marketing_version}",
      "CURRENT_PROJECT_VERSION=#{build_number}",
      "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
    ].join(" "),
  )

  # 2. Export the signed IPA. Xcode 26 strips declared capabilities (App Groups)
  #    from the .xcent while packaging, and exportArchive re-signs the app from
  #    that stripped .xcent — so the IPA comes out without the group regardless
  #    of anything done to the archived binary first (re-signing the archive
  #    beforehand was silently undone here). We fix it after export instead.
  build_app(
    skip_build_archive: true,
    archive_path: archive_path,
    output_directory: File.join(REPO_ROOT, "build"),
    output_name: "EveryByteCounts.ipa",
    export_method: "app-store",
    export_options: {
      method: "app-store",
      signingStyle: "manual",
      teamID: ENV.fetch("APPLE_TEAM_ID"),
      signingCertificate: "Apple Distribution",
      provisioningProfiles: {
        APP_ID    => ENV.fetch("sigh_#{APP_ID}_appstore_profile-name"),
        WIDGET_ID => ENV.fetch("sigh_#{WIDGET_ID}_appstore_profile-name"),
      },
    },
  )
  ipa = Fastlane::Actions.lane_context[Fastlane::Actions::SharedValues::IPA_OUTPUT_PATH]

  # 3. Re-assert each target's declared entitlements onto the EXPORTED IPA and
  #    re-sign it in place. This is the LAST signing operation — nothing runs
  #    after it — so the App Group finally survives into the shipped binary (both
  #    its XML and DER entitlements). Re-signing the archive didn't work because
  #    exportArchive re-signs again from Xcode's stripped .xcent.
  resign_exported_ipa(ipa)

  # 4. Gate: fail before upload if any declared entitlement is missing from the
  #    shipped signature or its embedded provisioning profile.
  verify_declared_entitlements(ipa)
  ipa
end

# Inspect the exported IPA and fail unless the app and each embedded extension
# carry every key/value their .entitlements file declares — in BOTH the code
# signature AND the embedded provisioning profile. Raises (failing the lane) via
# scripts/entitlements.py, which exits non-zero on a missing entry.
#
# The two-place check matters: a capability in the signature is necessary but
# NOT sufficient. At runtime iOS grants an entitlement only if the embedded
# provisioning profile also authorises it, so a build can carry the App Group in
# its signature (what `codesign -d` and the old check saw) yet have
# containerURL(forSecurityApplicationGroupIdentifier:) return nil on device
# because the profile doesn't list the group — which crashes the app on launch
# (fatalError in DashboardModel). match manages profiles but NOT App-ID
# capabilities, so if App Groups isn't enabled on the App IDs the minted
# profiles silently omit it. This gate turns that into a build-time failure.
def verify_declared_entitlements(ipa)
  tool       = ENTITLEMENTS_TOOL
  app_ent    = APP_ENTITLEMENTS
  widget_ent = WIDGET_ENTITLEMENTS
  sh(<<~BASH)
    set -euo pipefail
    IPA="#{ipa}"
    WORK="$(mktemp -d)"
    unzip -qo "$IPA" -d "$WORK"
    APP="$(ls -d "$WORK/Payload/"*.app | head -1)"
    check() {
      bundle="$1"; declared="$2"
      # 1. Code signature must carry every declared entitlement.
      ent="$(mktemp)"
      codesign -d --entitlements :- "$bundle" > "$ent" 2>/dev/null || true
      plutil -convert xml1 "$ent" 2>/dev/null || true
      echo "----- signature entitlements: $(basename "$bundle") -----"
      plutil -p "$ent" 2>/dev/null || cat "$ent"
      python3 "#{tool}" check "$ent" "$declared"
      # Parser-independent backstop: the plist check alone once reported OK on a
      # signature that visibly lacked the App Group, so also grep the normalised
      # dump for every declared group string.
      groups="$(mktemp)"
      grep -oE 'group\\.[A-Za-z0-9._-]+' "$declared" | sort -u > "$groups" || true
      while IFS= read -r grp; do
        [ -z "$grp" ] && continue
        grep -q "$grp" "$ent" || { echo "::error::$(basename "$bundle"): shipped signature is missing App Group '$grp' — would crash on launch (nil App Group container)."; exit 1; }
      done < "$groups"
      echo "OK: $(basename "$bundle") signature carries every declared entitlement"

      # 2. Embedded provisioning profile must AUTHORISE every declared
      #    (capability) entitlement — else iOS strips it at runtime.
      prof="$(mktemp)"; prof_ent="$(mktemp)"
      security cms -D -i "$bundle/embedded.mobileprovision" > "$prof" 2>/dev/null
      /usr/libexec/PlistBuddy -x -c "Print :Entitlements" "$prof" > "$prof_ent"
      echo "----- provisioning-profile entitlements: $(basename "$bundle") -----"
      plutil -p "$prof_ent" 2>/dev/null || cat "$prof_ent"
      if ! python3 "#{tool}" check "$prof_ent" "$declared"; then
        echo "::error::$(basename "$bundle"): its embedded provisioning profile does NOT authorise a declared entitlement (e.g. the App Group). iOS will strip it at runtime and the app will crash on launch. Enable the App Groups capability (with group.fi.mailhub.everybytecounts) on BOTH App IDs in the Developer portal, then regenerate the match profiles (MATCH_READONLY=false, or 'fastlane match appstore --force')."
        exit 1
      fi
      echo "OK: $(basename "$bundle") profile authorises every declared entitlement"
    }
    check "$APP" "#{app_ent}"
    for ext in "$APP/PlugIns/"*.appex; do
      [ -e "$ext" ] && check "$ext" "#{widget_ent}"
    done
  BASH
end

# App Store Connect API key from the existing repo secrets. key_content is the
# raw .p8 text (not base64), matching how APP_STORE_CONNECT_API_KEY_P8 is stored.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
    is_key_content_base64: false,
    in_house: false, # standard Developer Program, NOT enterprise
  )
end

# Re-sign the bundles INSIDE the exported IPA with their declared entitlements
# merged back in, then repackage the IPA in place. This runs after export, so it
# is the final signing operation — unlike re-signing the archive, which
# exportArchive overwrites when it re-signs from Xcode 26's stripped .xcent.
#
# Widget (nested) is signed before the app (inside-out) so the app's seal
# captures the re-signed widget. --generate-entitlement-der is load-bearing on
# Xcode 15+/26: iOS enforces the DER-encoded entitlements at runtime, and without
# it codesign writes our XML entitlements but regenerates the DER blob from a
# reduced set — dropping com.apple.security.application-groups. That shipped a
# binary that passed `codesign -d` yet returned nil from
# containerURL(forSecurityApplicationGroupIdentifier:) on device (the crash).
def resign_exported_ipa(ipa)
  app_ent    = APP_ENTITLEMENTS
  widget_ent = WIDGET_ENTITLEMENTS
  tool       = ENTITLEMENTS_TOOL
  sh(<<~BASH)
    set -euo pipefail
    IPA="#{ipa}"
    TOOL="#{tool}"
    IDENTITY="Apple Distribution"
    KCARG=""
    [ -n "${MATCH_KEYCHAIN_NAME:-}" ] && KCARG="--keychain ${MATCH_KEYCHAIN_NAME}"

    WORK="$(mktemp -d)"
    unzip -qo "$IPA" -d "$WORK"
    APP="$(ls -d "$WORK/Payload/"*.app | head -1)"

    resign() {
      bundle="$1"; declared="$2"
      [ -f "$declared" ] || { echo "::error::declared entitlements not found: $declared"; exit 1; }
      signed="$(mktemp)"; merged="$(mktemp)"
      # Start from what Xcode signed in (identifiers, team-id, get-task-allow,
      # beta-reports-active) and re-assert the declared capabilities on top.
      codesign -d --entitlements :- "$bundle" > "$signed" 2>/dev/null
      plutil -convert xml1 "$signed"
      python3 "$TOOL" merge "$signed" "$declared" "$merged"
      echo "entitlements handed to codesign for $(basename "$bundle"):"
      plutil -p "$merged"
      codesign --force --sign "$IDENTITY" $KCARG --generate-entitlement-der --entitlements "$merged" "$bundle"

      # Loud, parser-independent guard: every declared App Group MUST be present
      # in the re-signed binary or the build must not ship.
      after="$(mktemp)"
      codesign -d --entitlements :- "$bundle" > "$after" 2>/dev/null
      plutil -convert xml1 "$after" 2>/dev/null || true
      groups="$(mktemp)"
      grep -oE 'group\\.[A-Za-z0-9._-]+' "$declared" | sort -u > "$groups" || true
      while IFS= read -r grp; do
        [ -z "$grp" ] && continue
        grep -q "$grp" "$after" || { echo "::error::$(basename "$bundle"): re-sign did NOT retain App Group '$grp'."; exit 1; }
      done < "$groups"
      echo "re-signed exported $(basename "$bundle")"
    }

    # Inside-out: the widget (nested in PlugIns) before the containing app.
    for ext in "$APP/PlugIns/"*.appex; do
      [ -e "$ext" ] && resign "$ext" "#{widget_ent}"
    done
    resign "$APP" "#{app_ent}"

    # Repackage the IPA in place. Zip every top-level entry (Payload plus any
    # SwiftSupport/Symbols gym emitted) so nothing is dropped.
    rm -f "$IPA"
    ( cd "$WORK" && zip -qXry "$IPA" $(cd "$WORK" && ls -A) )
    echo "repackaged $(basename "$IPA")"
  BASH
end

def apply_signing(target, profile_name)
  update_code_signing_settings(
    path: PROJECT,
    use_automatic_signing: false,
    team_id: ENV.fetch("APPLE_TEAM_ID"),
    code_sign_identity: "Apple Distribution",
    profile_name: profile_name,
    targets: [target],
    build_configurations: ["Release"],
  )
end
